###> Symfony ###
APP_ENV=dev
# PRODUCTION : remplacer par une chaîne aléatoire de 32 caractères (ex: bin/console secrets:generate-keys)
APP_SECRET=change_me_with_a_random_32_char_string
###< Symfony ###

###> doctrine/doctrine-bundle ###
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=secret
POSTGRES_PORT=5432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# PRODUCTION : remplacer par une passphrase forte et unique (ex: openssl rand -base64 32)
JWT_PASSPHRASE=change_me
JWT_TTL=3600
###< lexik/jwt-authentication-bundle ###

###> auth cookie ###
JWT_COOKIE_NAME=auth_token
JWT_COOKIE_SECURE=1
JWT_COOKIE_SAMESITE=lax
JWT_COOKIE_PATH=/
JWT_COOKIE_DOMAIN=
###< auth cookie ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> Mailer (Mailpit en dev) ###
MAILER_DSN=smtp://mailpit:1025
###< Mailer ###

###> Docker ports (optionnel, override local) ###
NGINX_PORT=8080
MAILPIT_PORT=8025
###< Docker ports ###

DEFAULT_URI=localhost


### > L'url de ton front ici ###
APP_BASE_URL=http://localhost:8080
